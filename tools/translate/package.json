{
  "name": "@free-translation-platform/translate",
  "version": "1.0.0",
  "description": "Context-aware translation tool using Gemini API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "translate": "npm run build && node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "keywords": [
    "translation",
    "i18n",
    "gemini",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@google/genai": "^2.18.0"
  }
}

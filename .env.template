# ========================================
# GitLab Configuration
# ========================================
GITLAB_ROOT_PASSWORD=gitlab_admin_password

# ========================================
# Gemini API Configuration
# ========================================
# Get your API key from: https://aistudio.google.com/app/apikey
# IMPORTANT: This must ALSO be added as a GitLab CI/CD variable
# (Project > Settings > CI/CD > Variables) so the translate job can access it.
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# Translation Configuration
# ========================================
# Target languages to translate to (comma-separated)
# Language codes: fr=French, ja=Japanese, zh-Hant-HK=Chinese Traditional (HK),
#                 es=Spanish, de=German, ko=Korean, etc.
# This is also set in .gitlab-ci.yml and can be overridden in the Run pipeline form.
TARGET_LANGUAGES=fr,ja,zh-Hant-HK

# ========================================
# GitLab CI Runner Configuration
# ========================================
# Runner registration token (get from GitLab Admin > CI/CD > Runners)
# This is set up during setup.sh
GITLAB_RUNNER_TOKEN=

# ========================================
# Basic Configuration
# ========================================
POSTGRES_PASSWORD=weblate_password
POSTGRES_USER=weblate
POSTGRES_DATABASE=weblate

WEBLATE_ADMIN_NAME=Admin
WEBLATE_ADMIN_EMAIL=admin@example.com
WEBLATE_ADMIN_PASSWORD=admin

GITLAB_ROOT_PASSWORD=gitlab_admin_password

# ========================================
# Weblate Site Configuration
# ========================================
WEBLATE_SITE_TITLE=Weblate
WEBLATE_SITE_DOMAIN=weblate.local:8080
WEBLATE_ALLOWED_HOSTS=localhost,127.0.0.1,weblate.local
WEBLATE_CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://localhost:8080,https://weblate.local:8080
WEBLATE_DEBUG=1
WEBLATE_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Weblate Webhook URL (for GitLab to call)
# For local Docker: use container name (http://weblate:8080)
# For production: use your public HTTPS URL (https://weblate.yourcompany.com)
WEBLATE_WEBHOOK_URL=http://weblate:8080

# Email (for local development)
WEBLATE_EMAIL_HOST=localhost
WEBLATE_EMAIL_HOST_USER=
WEBLATE_EMAIL_HOST_PASSWORD=
WEBLATE_SERVER_EMAIL=noreply@example.com
WEBLATE_DEFAULT_FROM_EMAIL=noreply@example.com

# ========================================
# Google Translate API Key
# ========================================
# Get your key from: https://console.cloud.google.com/apis/credentials
# This is used by Weblate for machine translation
WEBLATE_MT_GOOGLE_KEY=MY_WEBLATE_MT_GOOGLE_KEY

# ========================================
# GitLab Repository Configuration
# ========================================
# GitLab repository details for Weblate to connect to
GITLAB_PROJECT_NAMESPACE=test
GITLAB_PROJECT_NAME=test-translation
GITLAB_REPO_URL=ssh://git@gitlab:22/test/test-translation.git
GITLAB_BRANCH=main

# GitLab API Token (auto-generated by auto-setup.sh or create manually)
# Used for automatic webhook creation
# Leave empty to have auto-setup.sh generate one automatically
GITLAB_API_TOKEN=

# ========================================
# Translation Configuration
# ========================================
# Source language (the language your app is written in)
SOURCE_LANGUAGE=en_US

# Target languages to auto-translate to (comma-separated language codes)
# Language codes: ja=Japanese, fr=French, zh_Hant=Chinese Traditional,
#                 es=Spanish, de=German, ko=Korean, etc.
TARGET_LANGUAGES=ja,fr,zh_Hant_HK

# Translation file configuration
FILE_MASK=*.json
FILE_FORMAT=json-nested
NEW_BASE=en-US.json

# ========================================
# Weblate Project Configuration
# ========================================
# Project details to be created in Weblate
WEBLATE_PROJECT_NAME="Test Translation"
WEBLATE_PROJECT_SLUG=test-translation
WEBLATE_COMPONENT_NAME=gitlab
WEBLATE_COMPONENT_SLUG=gitlab

# Auto-translation settings
AUTO_TRANSLATE_ENABLED=true
AUTO_TRANSLATE_MODE=translate
# Mode options:
#   - translate: Automatically accept translations (default)
#   - suggest: Create suggestions for manual review
#   - fuzzy: Mark auto-translations as fuzzy (needs review)
AUTO_TRANSLATE_THRESHOLD=80

# Push on commit: If true, translations are automatically pushed to GitLab.
# Set to false if you want to manually review before pushing.
PUSH_ON_COMMIT=true

# Weblate admin username (used for operations)
WEBLATE_ADMIN_USER=admin

# ========================================
# Docker Hub Configuration (Optional)
# ========================================
# Configure these to build and push multi-platform images to Docker Hub
# Leave empty to skip Docker Hub push and use local builds only

# Docker Hub username
DOCKER_HUB_USERNAME=

# Docker Hub password or personal access token
# Create token at: https://hub.docker.com/settings/security
DOCKER_HUB_TOKEN=

# Docker Hub repository name for webhook service
# Format: username/repository-name
# Example: myuser/weblate-webhook-reloader
DOCKER_HUB_WEBHOOK_REPO=

# Build platforms (comma-separated)
# Options: linux/amd64,linux/arm64,linux/arm/v7
# Default: linux/amd64,linux/arm64
DOCKER_BUILD_PLATFORMS=linux/amd64,linux/arm64
